#!/usr/bin/env bash
## Installs nginx and configures /redirect_me as a 301 permanent redirect
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null
sudo sed -i '/redirect_me/d' /etc/nginx/sites-available/default
sudo sed -i '/server_name _;/a \\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-available/default
sudo service nginx restart
