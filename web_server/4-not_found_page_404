#!/usr/bin/env bash
# Installs nginx with a 301 redirect and a custom 404 page containing Ceci n'est pas une page
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
sed -i '/redirect_me/d; /error_page 404/d' /etc/nginx/sites-available/default
sed -i '/server_name _;/a \\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;\n\terror_page 404 /404.html;' /etc/nginx/sites-available/default
service nginx restart
