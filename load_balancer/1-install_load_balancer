#!/usr/bin/env bash
# Installs and configures HAProxy to roundrobin traffic to web-01 and web-02
sudo apt-get update -y
sudo apt-get install -y haproxy
echo "ENABLED=1" | sudo tee -a /etc/default/haproxy > /dev/null
sudo sed -i '/^global/a \    h1-case-adjust x-served-by X-Served-By' /etc/haproxy/haproxy.cfg
sudo sed -i '/^defaults/a \    option h1-case-adjust-bogus-client\n    option http-server-close' /etc/haproxy/haproxy.cfg
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<EOF

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    balance roundrobin
    server 7343-web-01 13.40.29.172:80 check
    server 7343-web-02 16.60.12.170:80 check
EOF
if ! sudo haproxy -c -f /etc/haproxy/haproxy.cfg > /dev/null 2>&1; then
    sudo sed -i '/h1-case-adjust/d' /etc/haproxy/haproxy.cfg
fi
sudo service haproxy restart
