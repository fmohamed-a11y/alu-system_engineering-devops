#!/usr/bin/env bash
# Configures nginx with a 301 redirect, a custom 404 page and an X-Served-By header set to the hostname
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html > /dev/null
sudo sed -i '/redirect_me/d; /error_page 404/d; /X-Served-By/d' /etc/nginx/sites-available/default
sudo sed -i '/server_name _;/a \\tadd_header X-Served-By $hostname;\n\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;\n\terror_page 404 /404.html;' /etc/nginx/sites-available/default
sudo service nginx restart
